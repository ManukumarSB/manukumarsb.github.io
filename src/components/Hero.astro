---
import { profile } from '../data/profile';
import PhoneDemo from './PhoneDemo.astro';
---

<section class="hero" id="top">
  <div class="hero__bg" aria-hidden="true">
    <div class="glow glow--a"></div>
    <div class="glow glow--b"></div>
    <div class="grid"></div>
  </div>

  <div class="wrap hero__inner">
    <div class="hero__copy">
      <p class="hero__meta mono" data-hero-fade>
        <span>{profile.name}</span>
        <span class="sep">/</span>
        <span>{profile.role}</span>
      </p>

      <h1 class="hero__title">
        <span class="split-line"><span>Mobile apps</span></span>
        <span class="split-line"><span>that feel <em class="serif">right</em></span></span>
        <span class="split-line"><span>&amp; don’t <em class="serif crash">crash.</em></span></span>
      </h1>

      <p class="hero__intro" data-hero-fade>{profile.intro}</p>

      <div class="hero__actions" data-hero-fade>
        <a href="#work" class="btn btn--primary" data-magnetic>
          See my work
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12l7 7 7-7" /></svg>
        </a>
        <button class="btn" type="button" data-chat-open data-magnetic>
          Ask my AI
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z" /></svg>
        </button>
        <a href={profile.links.github} class="btn" target="_blank" rel="noopener" data-magnetic>
          GitHub
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17 17 7M8 7h9v9" /></svg>
        </a>
      </div>

      <p class="hero__now mono" data-hero-fade>
        <span class="live"></span> Now: shipping three Flutter apps at PDI · {profile.location}
      </p>
    </div>

    <div class="hero__phone" data-hero-phone>
      <PhoneDemo />
    </div>
  </div>

  <a href="#work" class="hero__scroll mono" aria-label="Scroll to work" data-hero-fade>
    <span class="hero__scroll-line"></span> scroll
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 110px 0 80px;
    overflow: hidden;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.55;
  }
  .glow--a {
    width: 46vw;
    height: 46vw;
    top: -12vw;
    right: -8vw;
    background: radial-gradient(circle, rgba(43, 127, 255, 0.55), transparent 65%);
    animation: drift 18s ease-in-out infinite alternate;
  }
  .glow--b {
    width: 34vw;
    height: 34vw;
    bottom: -14vw;
    left: -8vw;
    background: radial-gradient(circle, rgba(255, 107, 74, 0.35), transparent 65%);
    animation: drift 22s ease-in-out infinite alternate-reverse;
  }
  @keyframes drift {
    to { transform: translate(-6vw, 5vw) scale(1.15); }
  }
  /* Dot grid that lights up around the cursor (--mx/--my set from JS). */
  .grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(160, 190, 255, 0.16) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, #000 30%, transparent 75%);
  }
  .grid::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(79, 209, 255, 0.9) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(220px circle at var(--mx, -999px) var(--my, -999px), #000, transparent 70%);
    -webkit-mask-image: radial-gradient(220px circle at var(--mx, -999px) var(--my, -999px), #000, transparent 70%);
  }

  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    align-items: center;
    gap: clamp(32px, 5vw, 80px);
  }
  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0 0 26px;
    font-size: 13px;
    color: var(--muted);
  }
  .sep {
    color: var(--faint);
  }
  .hero__title {
    margin: 0;
    font-size: clamp(46px, 6.4vw, 100px);
    line-height: 0.92;
    letter-spacing: -0.045em;
    font-weight: 700;
    font-variation-settings: 'wdth' 80;
  }
  .hero__title em {
    font-size: 1.08em;
    background: linear-gradient(100deg, var(--cyan), #9be7ff 60%, var(--cyan));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-right: 0.06em;
  }
  .hero__title em.crash {
    background: linear-gradient(100deg, var(--coral), #ffb199);
    -webkit-background-clip: text;
    background-clip: text;
  }
  .hero__intro {
    max-width: 540px;
    margin: 30px 0 0;
    color: var(--muted);
    font-size: clamp(16px, 1.4vw, 18px);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }
  .hero__now {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 34px 0 0;
    font-size: 12.5px;
    color: var(--muted);
  }
  .live {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--mint);
    box-shadow: 0 0 12px var(--mint);
  }
  .hero__phone {
    display: flex;
    justify-content: center;
  }
  .hero__scroll {
    position: absolute;
    left: var(--gutter);
    bottom: 28px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 12px;
    color: var(--faint);
  }
  .hero__scroll-line {
    position: relative;
    width: 1px;
    height: 42px;
    background: var(--line-strong);
    overflow: hidden;
  }
  .hero__scroll-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--cyan);
    animation: scrollcue 2s var(--ease-out) infinite;
  }
  @keyframes scrollcue {
    from { transform: translateY(-100%); }
    to { transform: translateY(100%); }
  }

  :global(.js-motion) [data-hero-fade] {
    opacity: 0;
    transform: translateY(24px);
  }
  :global(.js-motion) [data-hero-phone] {
    opacity: 0;
  }

  @media (max-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }
    .hero__phone {
      margin-top: 24px;
    }
    .hero__scroll {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .glow,
    .hero__scroll-line::after {
      animation: none;
    }
  }
</style>
