---
import { profile, skills, offline, nowLearning } from '../data/profile';
---

<section class="section" id="about">
  <div class="wrap">
    <p class="eyebrow">About</p>
    <h2 class="h2 about__title">
      <span class="split-line"><span>Off the keyboard,</span></span>
      <span class="split-line"><span><em class="serif">mostly outside.</em></span></span>
    </h2>

    <div class="bento">
      <figure class="cell cell--photo" data-reveal>
        <img src={profile.photo} alt={`Portrait of ${profile.name}`} width="296" height="296" loading="lazy" data-parallax-img />
        <figcaption class="mono">{profile.location}</figcaption>
      </figure>

      <div class="cell cell--story" data-reveal>
        <p class="story">
          I grew up in Karnataka, studied computer science at VTU, and wrote my first Flutter app back when it was still in
          beta. These days I live in Southern California and build apps for campaigns that can’t afford a crash on election day.
        </p>
        <p class="story story--dim">
          I like owning the whole thing: the widget tree, the release pipeline, the 2am Crashlytics alert. I review code the
          way I’d want mine reviewed — kindly, and with a reason for every comment.
        </p>
      </div>

      {offline.map((o, i) => (
        <div class={`cell cell--off cell--off-${i}`} data-reveal>
          <span class="cell__icon" aria-hidden="true">{['🏓', '🌲', '🎥'][i]}</span>
          <p class="cell__title">{o.title}</p>
          <p class="cell__text">{o.text}</p>
        </div>
      ))}

      <div class="cell cell--now" data-reveal>
        <p class="mono cell__label">currently learning</p>
        <p class="cell__now">{nowLearning}</p>
      </div>

      <div class="cell cell--skills" data-reveal>
        {Object.entries(skills).map(([group, items]) => (
          <div class="skillrow">
            <p class="mono skillrow__group">{group}</p>
            <div class="skillrow__items">
              {items.map((s) => <span class="skill">{s}</span>)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .about__title {
    margin-bottom: 56px;
  }
  .bento {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 16px;
  }
  .cell {
    position: relative;
    margin: 0;
    padding: 28px;
    border-radius: var(--radius);
    background: var(--panel);
    border: 1px solid var(--line);
    overflow: hidden;
  }
  .cell--photo {
    grid-column: span 2;
    grid-row: span 2;
    padding: 0;
    min-height: 360px;
  }
  .cell--photo img {
    position: absolute;
    inset: -8% 0;
    width: 100%;
    height: 116%;
    object-fit: cover;
    filter: grayscale(0.25) contrast(1.05);
    transition: filter 0.6s;
  }
  .cell--photo:hover img {
    filter: none;
  }
  .cell--photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent 55%, rgba(6, 8, 13, 0.85));
  }
  .cell--photo figcaption {
    position: absolute;
    left: 22px;
    bottom: 18px;
    z-index: 1;
    font-size: 12px;
    color: var(--text);
  }
  .cell--story {
    grid-column: span 4;
  }
  .story {
    margin: 0;
    font-size: clamp(19px, 1.9vw, 24px);
    line-height: 1.45;
    letter-spacing: -0.01em;
  }
  .story--dim {
    margin-top: 18px;
    color: var(--muted);
    font-size: clamp(16px, 1.4vw, 18px);
  }
  .cell--off {
    grid-column: span 2;
  }
  .cell__icon {
    font-size: 28px;
    display: inline-block;
    transition: transform 0.6s var(--ease-out);
  }
  .cell--off:hover .cell__icon {
    transform: rotate(-14deg) scale(1.2);
  }
  .cell__title {
    margin: 14px 0 4px;
    font-weight: 600;
    font-size: 19px;
  }
  .cell__text {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
  }
  .cell--now {
    grid-column: span 4;
    background: linear-gradient(140deg, rgba(79, 209, 255, 0.14), rgba(43, 127, 255, 0.04)), var(--panel);
  }
  .cell__label {
    margin: 0;
    font-size: 12px;
    color: var(--cyan);
  }
  .cell__now {
    margin: 12px 0 0;
    font-size: 18px;
    line-height: 1.4;
  }
  .cell--skills {
    grid-column: span 6;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px 40px;
  }
  .skillrow {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 12px;
    align-items: baseline;
  }
  .skillrow__group {
    margin: 0;
    font-size: 12px;
    color: var(--muted);
  }
  .skillrow__items {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
  }
  .skill {
    font-size: 15px;
    transition: color 0.3s;
  }
  .skill:hover {
    color: var(--cyan);
  }
  @media (max-width: 960px) {
    .bento {
      grid-template-columns: 1fr 1fr;
    }
    .cell--photo,
    .cell--story,
    .cell--skills {
      grid-column: span 2;
    }
    .cell--photo {
      grid-row: auto;
      min-height: 420px;
    }
    .cell--off,
    .cell--now {
      grid-column: span 1;
    }
    .cell--skills {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .bento {
      grid-template-columns: 1fr;
    }
    .cell {
      grid-column: span 1 !important;
    }
    .skillrow {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .cell--skills {
      grid-template-columns: 1fr;
    }
  }
</style>
