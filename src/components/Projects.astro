---
import { projects } from '../data/profile';
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="projects" id="projects" data-hscroll>
  <div class="projects__pin">
    <header class="wrap projects__head">
      <div>
        <p class="eyebrow">Selected projects</p>
        <h2 class="h2">
          <span class="split-line"><span>Shipped, used,</span></span>
          <span class="split-line"><span><em class="serif">still running.</em></span></span>
        </h2>
      </div>
      <p class="projects__count mono" aria-hidden="true">
        <span data-hscroll-index>01</span> / {pad(projects.length)}
      </p>
    </header>

    <div class="projects__viewport">
      <ul class="projects__track" data-hscroll-track>
        {projects.map((p, i) => {
          const Tag = p.url ? 'a' : 'div';
          return (
            <li class="proj" style={`--accent:${p.accent}`}>
              <Tag
                class="proj__card"
                {...(p.url ? { href: p.url, target: '_blank', rel: 'noopener' } : {})}
              >
                <div class="proj__art" aria-hidden="true">
                  <span class="proj__num">{pad(i + 1)}</span>
                  <span class="proj__orb"></span>
                  <span class="proj__rings"></span>
                </div>
                <div class="proj__body">
                  <p class="proj__kind mono">{p.kind}</p>
                  <h3 class="proj__title">
                    {p.title}
                    {p.url && <span class="proj__arrow" aria-hidden="true">↗</span>}
                  </h3>
                  <p class="proj__blurb">{p.blurb}</p>
                  <div class="proj__tags">
                    {p.tags.map((t) => <span class="tag">{t}</span>)}
                  </div>
                </div>
              </Tag>
            </li>
          );
        })}
      </ul>
    </div>
  </div>
</section>

<style>
  .projects {
    position: relative;
    padding: clamp(96px, 12vw, 160px) 0 clamp(60px, 8vw, 100px);
  }
  .projects__pin {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 48px;
  }
  .projects__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
  }
  .projects__count {
    margin: 0;
    font-size: 14px;
    color: var(--muted);
  }
  .projects__count span {
    color: var(--text);
  }
  .projects__viewport {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .projects__viewport::-webkit-scrollbar {
    display: none;
  }
  .projects__track {
    display: flex;
    gap: 20px;
    width: max-content;
    margin: 0;
    padding: 0 var(--gutter);
    list-style: none;
  }
  /* Desktop + motion: JS pins the section and drives the track sideways. */
  :global(.js-motion) .projects.is-pinned .projects__viewport {
    overflow: visible;
  }
  .proj {
    width: min(78vw, 480px);
    scroll-snap-align: center;
  }
  .proj__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: var(--radius);
    background: var(--panel);
    border: 1px solid var(--line);
    overflow: hidden;
    transition: border-color 0.4s, transform 0.6s var(--ease-out);
  }
  .proj__card:hover {
    border-color: color-mix(in srgb, var(--accent) 60%, transparent);
    transform: translateY(-6px);
  }
  .proj__art {
    position: relative;
    height: 240px;
    overflow: hidden;
    background:
      linear-gradient(160deg, color-mix(in srgb, var(--accent) 22%, transparent), transparent 70%),
      var(--panel-2);
  }
  .proj__num {
    position: absolute;
    left: 22px;
    bottom: -18px;
    font-size: 132px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.06em;
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in srgb, var(--accent) 55%, transparent);
    transition: transform 0.8s var(--ease-out);
  }
  .proj__orb {
    position: absolute;
    right: 40px;
    top: 40px;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #fff, var(--accent) 35%, transparent 72%);
    filter: blur(2px);
    opacity: 0.85;
    transition: transform 0.8s var(--ease-out);
  }
  .proj__rings {
    position: absolute;
    right: -40px;
    top: -40px;
    width: 280px;
    height: 280px;
    border-radius: 50%;
    background: repeating-radial-gradient(
      circle,
      transparent 0 18px,
      color-mix(in srgb, var(--accent) 25%, transparent) 18px 19px
    );
    transition: transform 1.2s var(--ease-out);
  }
  .proj__card:hover .proj__num {
    transform: translateX(10px);
  }
  .proj__card:hover .proj__orb {
    transform: translate(-16px, 14px) scale(1.12);
  }
  .proj__card:hover .proj__rings {
    transform: rotate(40deg) scale(1.08);
  }
  .proj__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 26px 28px 30px;
  }
  .proj__kind {
    margin: 0;
    font-size: 12px;
    color: var(--accent);
  }
  .proj__title {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin: 10px 0 0;
    font-size: clamp(24px, 2.4vw, 30px);
    letter-spacing: -0.025em;
    line-height: 1.1;
    font-weight: 650;
  }
  .proj__arrow {
    color: var(--muted);
    transition: transform 0.4s var(--ease-out), color 0.4s;
  }
  .proj__card:hover .proj__arrow {
    color: var(--accent);
    transform: translate(3px, -3px);
  }
  .proj__blurb {
    margin: 14px 0 0;
    color: var(--muted);
    font-size: 15px;
    flex: 1;
  }
  .proj__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 22px;
  }
</style>
