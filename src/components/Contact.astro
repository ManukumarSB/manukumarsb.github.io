---
import { profile } from '../data/profile';
const year = new Date().getFullYear();
const word = 'pickleball.';
---

<section class="contact" id="contact">
  <div class="contact__glow" aria-hidden="true"></div>
  <div class="wrap">
    <p class="eyebrow">Contact</p>
    <h2 class="contact__title">
      <span class="split-line"><span>Talk Flutter,</span></span>
      <span class="split-line"><span>packages, or</span></span>
      <span class="split-line">
        <span class="contact__wave serif" aria-label={word}>
          {[...word].map((c) => <span class="ch" aria-hidden="true">{c}</span>)}
        </span>
      </span>
    </h2>

    <div class="contact__row">
      <p class="lede" data-reveal>
        Found a bug in one of my packages, or just want to swap notes on Flutter? Say hi.
      </p>

      <div class="contact__actions" data-reveal>
        <a class="contact__mail" href={`mailto:${profile.email}`} data-magnetic data-magnetic-strength="0.5">
          <span class="contact__mail-inner">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
            Say hello
          </span>
        </a>
        <button class="contact__copy mono" type="button" data-copy={profile.email}>
          {profile.email} <span data-copy-label>copy</span>
        </button>
      </div>
    </div>
  </div>

  <footer class="footer wrap">
    <p class="mono">© {year} {profile.fullName}</p>
    <nav class="footer__links" aria-label="Elsewhere">
      <a href={profile.links.github} target="_blank" rel="noopener">GitHub</a>
      <a href={profile.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a href={profile.links.pub} target="_blank" rel="noopener">pub.dev</a>
    </nav>
    <p class="mono footer__built">Built with Astro &amp; GSAP. No templates were harmed.</p>
  </footer>
</section>

<style>
  .contact {
    position: relative;
    padding: clamp(110px, 15vw, 200px) 0 40px;
    overflow: hidden;
    border-top: 1px solid var(--line);
  }
  .contact__glow {
    position: absolute;
    left: 50%;
    bottom: -40vw;
    width: 110vw;
    height: 70vw;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(43, 127, 255, 0.35), rgba(79, 209, 255, 0.08) 60%, transparent);
    filter: blur(20px);
    pointer-events: none;
  }
  .contact__title {
    margin: 22px 0 0;
    font-size: clamp(56px, 11vw, 176px);
    line-height: 0.9;
    letter-spacing: -0.05em;
    font-weight: 700;
    font-variation-settings: 'wdth' 78;
  }
  .contact__wave {
    display: inline-flex;
    color: var(--cyan);
    font-size: 1.1em;
    letter-spacing: -0.02em;
  }
  .ch {
    display: inline-block;
    transition: transform 0.5s var(--ease-out), color 0.5s;
  }
  .ch:hover {
    transform: translateY(-0.12em) rotate(-6deg);
    color: var(--coral);
  }
  .contact__row {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 40px;
    margin-top: 64px;
  }
  .contact__actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .contact__mail {
    display: grid;
    place-items: center;
    width: 190px;
    height: 190px;
    border-radius: 50%;
    background: var(--cyan);
    color: var(--ink);
    font-weight: 650;
    font-size: 18px;
    box-shadow: 0 30px 80px -20px rgba(79, 209, 255, 0.6);
    transition: background 0.4s, box-shadow 0.4s;
  }
  .contact__mail:hover {
    background: var(--text);
    box-shadow: 0 30px 90px -10px rgba(233, 238, 247, 0.5);
  }
  .contact__mail-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
  .contact__mail svg {
    width: 28px;
    height: 28px;
  }
  .contact__copy {
    padding: 8px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font-size: 12.5px;
    cursor: pointer;
    transition: border-color 0.3s, color 0.3s;
  }
  .contact__copy:hover {
    border-color: var(--cyan);
    color: var(--text);
  }
  .contact__copy.is-copied span {
    color: var(--mint);
  }
  .footer {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: clamp(100px, 12vw, 160px);
    padding-top: 28px;
    border-top: 1px solid var(--line);
    font-size: 13px;
    color: var(--muted);
  }
  .footer p {
    margin: 0;
    font-size: 12px;
  }
  .footer__links {
    display: flex;
    gap: 24px;
  }
  .footer__links a {
    transition: color 0.3s;
  }
  .footer__links a:hover {
    color: var(--cyan);
  }
  .footer__built {
    color: var(--faint);
  }
</style>
